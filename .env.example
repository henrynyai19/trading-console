# --- Market data (OANDA v20). Create a free practice account and API token in the OANDA hub. ---
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice            # practice | live
# --- Optional Supabase candle cache. Leave empty to talk to OANDA directly. ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=         # service-role key, backend only
# --- CORS ---
ALLOWED_ORIGIN=http://localhost:3000
