# Server environment: development | test | production
APP_ENV=development

# Public live feed, no account or API key required. Options: biquote | oanda
MARKET_DATA_PROVIDER=biquote

# Only needed when MARKET_DATA_PROVIDER=oanda
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice            # practice | live

# Optional Supabase setup history. Biquote candles are fetched directly from its provider.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=         # service-role key, backend only

# Browser origin(s), comma separated if more than one. Production origins must use HTTPS.
ALLOWED_ORIGIN=http://localhost:3000

# Optional structured application log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Test-only: synthetic mock endpoints. Never set for normal use.
# OANDA_REST_URL=http://127.0.0.1:8101
# OANDA_STREAM_URL=http://127.0.0.1:8101
